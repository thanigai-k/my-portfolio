---
import { Image } from 'astro:assets'
import Base from './Base.astro'
import SparkLink from '../components/SparkLink.astro'
import PrevNext from '../components/PrevNext.astro'
import type { Section } from '../components/BottomBar.astro'
import { site } from '../site.config'

interface Link {
  href: string
  title: string
}
interface Props {
  title: string
  summary: string
  /** Mono caps line above the title, e.g. "Notes · 4 min · Sep 2026". */
  kicker: string
  crumb: Link
  section: Section
  /** Hero slot, first match wins: image → TL;DR → nothing (docs/adr/0003). */
  hero: {
    image?: ImageMetadata
    tldr?: string[]
  }
  prevNextLabel: string
  prev?: Link
  next?: Link
}
const { title, summary, kicker, crumb, section, hero, prevNextLabel, prev, next } = Astro.props
const crumbLink = 'text-muted no-underline'
---

<Base title={title} description={summary} section={section}>
  <article id="content" class="flex flex-col gap-[22px] text-[17px]/[1.65]">
    <nav
      aria-label="Breadcrumb"
      class="flex items-center gap-4 font-mono text-[13px] max-md:gap-x-3 max-md:gap-y-1"
    >
      <SparkLink tap href="/" class={crumbLink}>
        ← {site.name}
      </SparkLink>
      <span aria-hidden="true" class="text-edge">
        /
      </span>
      <SparkLink tap href={crumb.href} class={crumbLink}>
        {crumb.title}
      </SparkLink>
    </nav>

    <header class="mt-3 flex flex-col gap-3.5">
      <p class="meta tracking-[0.04em] text-muted uppercase">{kicker}</p>
      <h1 class="text-[clamp(28px,4vw+14px,36px)]/[1.15] font-bold tracking-[-0.01em]">{title}</h1>
      <p class="text-[1.18em]/normal text-ink-soft">{summary}</p>
    </header>

    {hero.image ? (
      <Image
        src={hero.image}
        alt=""
        class="mt-2 block aspect-[3/2] w-full rounded-md bg-surface object-cover"
      />
    ) : (
      hero.tldr && (
        <aside
          aria-label="Summary"
          class="mt-2 flex flex-col gap-2.5 rounded-md border border-rule bg-surface px-5 py-[18px]"
        >
          <span class="meta tracking-[0.04em] text-muted uppercase">TL;DR</span>
          <ul class="flex list-disc flex-col gap-1.5 pl-[18px]">
            {hero.tldr.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </aside>
      )
    )}

    <hr class="my-1.5 border-rule" />

    <div class="prose max-w-none text-[17px]/[1.65] prose-palette prose-h2:text-[1.3em] prose-blockquote:border-l-2 prose-blockquote:font-normal prose-blockquote:not-italic prose-img:rounded-md prose-pre:border prose-pre:border-rule">
      <slot />
    </div>

    <footer class="mt-6 flex flex-col gap-2.5 border-t border-rule pt-5 text-sm">
      {(prev || next) && <PrevNext label={prevNextLabel} prev={prev} next={next} />}
      <p class="mt-2 text-muted">
        Thoughts? Email{' '}
        <SparkLink tap href={`mailto:${site.email}`}>
          {site.email}
        </SparkLink>
      </p>
    </footer>
  </article>
</Base>
