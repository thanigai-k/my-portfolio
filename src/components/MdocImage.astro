---
import { Image } from 'astro:assets'

interface Props {
  src: ImageMetadata
  alt?: string
  /** `![alt](src "caption")` — the title becomes the caption. */
  title?: string
}
const { src, alt = '', title } = Astro.props
---

<Image src={src} alt={alt} class="block h-auto w-full rounded-md bg-surface" />
{title && <span class="meta mt-2 block text-muted">{title}</span>}
