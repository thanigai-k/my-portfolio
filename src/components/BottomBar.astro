---
export type Section = 'home' | 'projects' | 'writing'
interface Props {
  current?: Section
}
const { current } = Astro.props

const items = [
  { id: 'home', label: 'Home', href: '/', icon: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z' },
  { id: 'projects', label: 'Projects', href: '/#projects', icon: 'M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18' },
  { id: 'writing', label: 'Writing', href: '/writing', icon: 'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z' },
  { id: 'contact', label: 'Contact', href: '/#contact', icon: 'M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zm-2 2 9 6 9-6' },
]
---

<!-- Phones only. Sticky at the end of <body>, so it rides the viewport bottom. -->
<nav
  aria-label="Primary"
  class="sticky bottom-0 z-20 grid grid-cols-4 border-t border-rule bg-bg px-2 pt-1 pb-[calc(4px+env(safe-area-inset-bottom))] md:hidden"
>
  {
    items.map((item) => (
      <a
        href={item.href}
        aria-current={item.id === current ? 'page' : undefined}
        class="relative flex min-h-14 flex-col items-center justify-center gap-1 rounded-lg text-xs/tight text-ink-soft no-underline active:bg-raised aria-[current=page]:font-semibold aria-[current=page]:text-ink aria-[current=page]:before:absolute aria-[current=page]:before:top-0 aria-[current=page]:before:left-1/2 aria-[current=page]:before:h-0.5 aria-[current=page]:before:w-6 aria-[current=page]:before:-translate-x-1/2 aria-[current=page]:before:rounded-sm aria-[current=page]:before:bg-ink"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="size-[22px] fill-none stroke-current stroke-[1.75] [stroke-linecap:round] [stroke-linejoin:round]"
        >
          <path d={item.icon} />
        </svg>
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>
