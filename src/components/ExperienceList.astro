---
import type { CollectionEntry } from 'astro:content'

interface Props {
  entries: CollectionEntry<'experiences'>[]
}
const { entries } = Astro.props
---

{entries.map(({ data }) => (
  <div class="flex flex-col gap-1">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6">
      <span>
        <strong class="font-medium">{data.role}</strong>
        <span class="text-muted"> - {data.company}</span>
      </span>
      <span class="meta whitespace-nowrap text-muted">{data.period}</span>
    </div>
    {data.summary && <p class="max-w-[600px] text-[0.9em] text-muted">{data.summary}</p>}
  </div>
))}
