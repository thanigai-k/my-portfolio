---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { isPublished } from "../../lib/content";

export async function getStaticPaths() {
    const studies = await getCollection("work", isPublished);
    return studies.map((study) => ({
        params: { slug: study.id },
        props: { study },
    }));
}

const { study } = Astro.props as { study: CollectionEntry<"work"> };
const { Content } = await render(study);
---

<Base title={study.data.title} description={study.data.summary} measure="wide">
    <a
        href="/work"
        class="type-meta mt-16 md:mt-[78px] inline-block text-muted2 no-underline"
        >&larr; work</a
    >
    <h1 class="type-h1Page mb-3.5 mt-3.5 max-w-[660px]">{study.data.title}</h1>
    <p class="type-lead mb-10 mt-0 max-w-[600px] text-muted">
        {study.data.summary}
    </p>

    <div class="figure-wide mt-12">
        {
            study.data.heroVideo ? (
                <video
                    src={study.data.heroVideo}
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="metadata"
                    style={`aspect-ratio:${study.data.heroVideoAspect ?? "16 / 9"};object-position:${study.data.heroVideoObjectPosition ?? "top"}`}
                    class="block w-full rounded-card bg-panel object-cover"
                />
            ) : (
                study.data.hero && (
                    <Image
                        src={study.data.hero}
                        alt=""
                        class="block w-full rounded-card"
                    />
                )
            )
        }
    </div>

    <div class="prose mx-auto mt-16 max-w-[var(--layout-readColumn)]">
        <Content />
    </div>
</Base>
