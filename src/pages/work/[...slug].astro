---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import { isPublished } from '../../lib/content'

export async function getStaticPaths() {
  const studies = await getCollection('work', isPublished)
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }))
}

const { study } = Astro.props as { study: CollectionEntry<'work'> }
const { Content } = await render(study)
---

<Base title={study.data.title} description={study.data.summary} measure="wide">
  <a href="/work" class="type-meta mt-16 md:mt-[78px] inline-block text-muted2 no-underline">&larr; work</a>
  <h1 class="type-h1Page mb-3.5 mt-3.5 max-w-[660px]">{study.data.title}</h1>
  <p class="type-lead mb-10 mt-0 max-w-[600px] text-muted">{study.data.summary}</p>

  <div
    class="flex h-[260px] items-center justify-center overflow-hidden rounded-card bg-[repeating-linear-gradient(45deg,var(--panel)_0_10px,var(--bg)_10px_20px)] md:h-[440px]"
  >
    {study.data.hero && <Image src={study.data.hero} alt="" class="size-full object-cover" />}
  </div>

  <div class="prose mx-auto mt-16 max-w-[var(--layout-readColumn)]">
    <Content />
  </div>
</Base>
