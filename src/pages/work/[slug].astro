---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import Post from '../../layouts/Post.astro'
import { isPublished } from '../../lib/content'

export async function getStaticPaths() {
  const studies = (await getCollection('work', isPublished)).sort(
    (a, b) => a.data.order - b.data.order,
  )
  const link = (s?: CollectionEntry<'work'>) => s && { href: `/work/${s.id}`, title: s.data.title }
  return studies.map((study, i) => ({
    params: { slug: study.id },
    props: { study, prev: link(studies[i - 1]), next: link(studies[i + 1]) },
  }))
}

const { study, prev, next } = Astro.props
const { data } = study
const { Content } = await render(study)
---

<Post
  title={data.title}
  summary={data.summary}
  kicker={[data.topic, 'Case study'].filter(Boolean).join(' · ')}
  crumb={{ href: '/#projects', title: 'Projects' }}
  section="projects"
  hero={{
    video: data.heroVideo
      ? {
          src: data.heroVideo,
          aspect: data.heroVideoAspect,
          position: data.heroVideoObjectPosition,
        }
      : undefined,
    image: data.hero,
    tldr: data.tldr,
  }}
  prevNextLabel="More case studies"
  prev={prev}
  next={next}
>
  <Content />
</Post>
