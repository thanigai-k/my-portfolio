---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import ExperienceList from '../components/ExperienceList.astro'

const experiences = (await getCollection('experiences')).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<Base title="Experiences" description="Full work history.">
  <h1 class="type-h1Page mb-2 mt-16 md:mt-[76px]">Experiences</h1>
  <p class="type-lead mb-11 mt-0 text-muted">
    Eight years, mostly one company, deliberately.
  </p>
  <ExperienceList entries={experiences} openCount={1} />
</Base>
