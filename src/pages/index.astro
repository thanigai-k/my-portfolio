---
import { getCollection, getEntry, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import SparkLink from '../components/SparkLink.astro'
import Sparkle from '../components/Sparkle.astro'
import ProjectRow from '../components/ProjectRow.astro'
import ExperienceList from '../components/ExperienceList.astro'
import PalettePicker from '../components/PalettePicker.astro'
import { site } from '../site.config'
import { isPublished, monthYear, roleVerb } from '../lib/content'

const home = (await getEntry('pages', 'home'))!
const { Content: Bio } = await render(home)

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order
const projects = (await getCollection('projects', isPublished)).sort(byOrder).map(({ data }) => ({
  name: data.title,
  role: data.role,
  tagline: data.tagline,
  summary: data.summary,
  href: data.href,
}))

// Only roles that have projects; the filter hides itself with fewer than two.
const roles = Object.keys(roleVerb).filter((r) => projects.some((p) => p.role === r))
const plural = (n: number) => `${n} project${n === 1 ? '' : 's'}`

const posts = (await getCollection('writing', isPublished))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

const experiences = (await getCollection('experiences')).sort(byOrder).slice(0, 3)

const h2 = 'text-xl font-bold max-md:text-[22px]'
---

<Base description={home.data.tagline} section="home">
  <main id="content" class="flex flex-col gap-11">
    <header class="flex flex-col gap-4">
      <div class="flex items-start justify-between gap-4">
        <div class="flex flex-col gap-1">
          <h1 class="text-2xl/tight font-bold">{site.name}</h1>
          <p class="text-muted">{site.role}</p>
        </div>
        <PalettePicker />
      </div>
      <div class="flex flex-col gap-4">
        <Bio />
      </div>
      <nav aria-label="Elsewhere" class="flex flex-wrap gap-4 max-md:gap-x-6 max-md:gap-y-0">
        {site.socials.map((s) => (
          <SparkLink tap href={s.href}>
            {s.label}
          </SparkLink>
        ))}
        <SparkLink tap href="/writing">
          Writing
        </SparkLink>
      </nav>
      <p>
        Email:{' '}
        <SparkLink tap href={`mailto:${site.email}`} class="text-muted">
          {site.email}
        </SparkLink>
      </p>
    </header>

    <section
      id="projects"
      aria-labelledby="projects-h"
      class="relative flex scroll-mt-4 flex-col gap-2.5 max-md:gap-0"
    >
      <div class="mb-1 flex flex-col gap-2 max-md:mb-3" data-role-filter>
        <div class="flex items-center justify-between gap-x-6 gap-y-3 max-md:flex-col max-md:items-stretch">
          <h2 id="projects-h" class={h2}>
            Projects
          </h2>
          {roles.length > 1 && (
            <div
              role="group"
              aria-label="Filter projects by role"
              class="-m-1.5 flex gap-1.5 overflow-x-auto p-1.5 [scrollbar-width:none] max-md:scroll-px-4 max-md:pr-10 max-md:[mask-image:linear-gradient(to_right,#000_calc(100%-40px),transparent)] [&::-webkit-scrollbar]:hidden"
            >
              {['all', ...roles].map((role) => (
                <button
                  type="button"
                  data-role={role}
                  aria-pressed={role === 'all' ? 'true' : 'false'}
                  class="group meta relative inline-flex h-7 shrink-0 cursor-pointer items-center gap-1.5 rounded-full border border-line bg-surface px-3 whitespace-nowrap text-muted transition-colors duration-150 hover:border-edge hover:text-ink aria-pressed:border-accent/40 aria-pressed:bg-accent/10 aria-pressed:text-accent-ink max-md:h-8 max-md:gap-2 max-md:px-3.5 max-md:after:absolute max-md:after:inset-x-0 max-md:after:-inset-y-1.5"
                >
                  <span
                    aria-hidden="true"
                    class="size-2 rounded-full border-[1.5px] border-current group-aria-pressed:bg-current group-aria-pressed:ring-2 group-aria-pressed:ring-accent/30 max-md:size-2.5"
                  />
                  {role}
                </button>
              ))}
            </div>
          )}
        </div>
        <p class="meta text-muted" aria-live="polite" data-result>
          {plural(projects.length)} · all roles
        </p>
      </div>
      {projects.map((p) => (
        <ProjectRow {...p} />
      ))}
      <div
        data-project-card
        aria-hidden="true"
        class="pointer-events-none absolute top-0 left-0 z-10 w-80 overflow-hidden rounded-[10px] border border-edge/50 bg-raised opacity-0 shadow-[0_12px_32px_rgb(0_0_0/0.45)] transition-[opacity,translate,height] duration-200 ease-out max-md:hidden motion-reduce:transition-opacity"
      >
        <div class="flex flex-col gap-2 px-4 pt-3.5 pb-4"></div>
      </div>
    </section>

    {posts.length > 0 && (
      <section
        id="writing"
        aria-labelledby="writing-h"
        class="flex scroll-mt-4 flex-col gap-2.5 max-md:gap-0"
      >
        <div class="mb-1 flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="writing-h" class={h2}>
            Writing
          </h2>
          <SparkLink tap href="/writing" class="text-muted">
            All posts →
          </SparkLink>
        </div>
        {posts.map((post) => (
          <a
            href={`/writing/${post.id}`}
            class="group/spk flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5 py-0.5 no-underline max-md:gap-y-1 max-md:border-t max-md:border-line max-md:py-3"
          >
            <span>
              <span class="relative transition-colors duration-150 md:group-hover/spk:text-white md:group-hover/spk:decoration-accent md:group-focus-visible/spk:text-white md:group-focus-visible/spk:decoration-accent font-medium underline decoration-edge underline-offset-3">
                <Sparkle />
                {post.data.title}
              </span>
              <span class="text-muted max-md:mt-0.5 max-md:block max-md:text-[15px]">
                <span class="max-md:hidden"> - </span>
                {post.data.summary}
              </span>
            </span>
            <span class="meta whitespace-nowrap text-muted">{monthYear(post.data.date)}</span>
          </a>
        ))}
      </section>
    )}

    <section
      id="experience"
      aria-labelledby="experience-h"
      class="flex scroll-mt-4 flex-col gap-[18px]"
    >
      <h2 id="experience-h" class={h2}>
        Experience
      </h2>
      <ExperienceList entries={experiences} />
    </section>

    <!-- Phones only: on desktop the header links already cover it. -->
    <section
      id="contact"
      aria-labelledby="contact-h"
      class="hidden scroll-mt-4 flex-col gap-2.5 max-md:flex"
    >
      <h2 id="contact-h" class:list={[h2, 'mb-1']}>
        Contact
      </h2>
      <p class="mb-1 text-muted">Email is the fastest way to reach me.</p>
      {[
        {
          label: 'Email',
          href: `mailto:${site.email}`,
          handle: site.email,
        },
        ...site.socials,
      ].map((c) => (
        <a
          href={c.href}
          class="flex min-h-11 flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-line py-2 no-underline active:text-accent"
        >
          <span class="font-semibold underline decoration-edge underline-offset-3">{c.label}</span>
          <span class="font-mono text-[13px] text-muted">
            {c.handle}
            {c.label !== 'Email' && ' ↗'}
          </span>
        </a>
      ))}
    </section>
  </main>
</Base>

<script>
  // Role filter; same pattern as the /writing topic filter.
  const filter = document.querySelector<HTMLElement>('[data-role-filter]')
  if (filter) {
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('button[data-role]')]
    const rows = [...document.querySelectorAll<HTMLElement>('#projects > [data-role]')]
    const result = filter.querySelector<HTMLElement>('[data-result]')!
    const plural = (n: number) => `${n} project${n === 1 ? '' : 's'}`
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)')

    filter.addEventListener('click', (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>('button[data-role]')
      if (!button) return
      const role = button.dataset.role
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === button))
      let shown = 0
      for (const row of rows) {
        row.hidden = role !== 'all' && row.dataset.role !== role
        if (!row.hidden) shown++
      }
      result.textContent =
        role === 'all'
          ? `${plural(rows.length)} · all roles`
          : `${shown} of ${plural(rows.length)} · ${role}`
      // Phones: keep the picked role centred in the sideways-scrolling row.
      button.scrollIntoView({
        inline: 'center',
        block: 'nearest',
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      })
    })
  }

  // One hover card glides between project rows (docs/adr/0005). It's a visual copy of the row's
  // hidden description, so it stays aria-hidden.
  const list = document.querySelector<HTMLElement>('#projects')
  const card = list?.querySelector<HTMLElement>('[data-project-card]')
  const body = card?.firstElementChild as HTMLElement | null | undefined

  if (list && card && body) {
    let shown = false
    let hideTimer = 0
    const show = (link: HTMLElement) => {
      const source = document.getElementById(link.getAttribute('aria-describedby') ?? '')
      if (!source) return
      clearTimeout(hideTimer)
      body.innerHTML = source.innerHTML
      const height = body.offsetHeight + card.offsetHeight - card.clientHeight
      const a = link.getBoundingClientRect()
      const b = list.getBoundingClientRect()
      // From hidden it fades in on the spot; while visible, position and height glide.
      card.style.transitionProperty = shown ? '' : 'opacity'
      card.style.translate = `${a.right - b.left + 16}px ${a.top - b.top + (a.height - height) / 2}px`
      card.style.height = `${height}px`
      card.style.opacity = '1'
      shown = true
    }
    // The delay keeps the card up while the pointer crosses the gap to the next row.
    const hide = () => {
      hideTimer = window.setTimeout(() => (card.style.opacity = '0'), 120)
    }
    card.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'opacity' && card.style.opacity === '0') shown = false
    })
    for (const link of list.querySelectorAll<HTMLElement>('a[aria-describedby]')) {
      link.addEventListener('pointerenter', (e) => e.pointerType !== 'touch' && show(link))
      link.addEventListener('pointerleave', hide)
      link.addEventListener('focusin', () => link.matches(':focus-visible') && show(link))
      link.addEventListener('focusout', hide)
    }
  }
</script>
