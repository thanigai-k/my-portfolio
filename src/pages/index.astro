---
import { getCollection, getEntry, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import SparkLink from '../components/SparkLink.astro'
import ProjectRow from '../components/ProjectRow.astro'
import ExperienceList from '../components/ExperienceList.astro'
import PalettePicker from '../components/PalettePicker.astro'
import { site, socials } from '../site.config'
import { isPublished, monthYear } from '../lib/content'

const home = (await getEntry('pages', 'home'))!
const { Content: Bio } = await render(home)

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order
const projects = [
  ...(await getCollection('work', isPublished)).sort(byOrder).map(({ id, data }) => ({
    name: data.title,
    tagline: data.tagline,
    summary: data.summary,
    stack: data.stack,
    href: `/work/${id}`,
    kind: 'Case study' as const,
  })),
  ...(await getCollection('projects')).sort(byOrder).map(({ data }) => ({
    name: data.title,
    tagline: data.tagline,
    summary: data.summary,
    stack: data.stack,
    href: data.href ?? '#',
    kind: 'Side project' as const,
  })),
]

const posts = (await getCollection('writing', isPublished))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

const experiences = (await getCollection('experiences')).sort(byOrder).slice(0, 3)

const h2 = 'text-xl font-bold max-md:text-[22px]'
---

<Base description={home.data.tagline} section="home">
  <main id="content" class="flex max-w-[720px] flex-col gap-11">
    <header class="flex flex-col gap-4">
      <div class="flex items-start justify-between gap-4">
        <div class="flex flex-col gap-1">
          <h1 class="text-2xl/tight font-bold">{site.name}</h1>
          <p class="text-muted">{site.role}</p>
        </div>
        <PalettePicker />
      </div>
      <div class="flex flex-col gap-4"><Bio /></div>
      <nav aria-label="Elsewhere" class="flex flex-wrap gap-4 max-md:gap-x-6 max-md:gap-y-0">
        {socials.map((s) => <SparkLink tap href={s.href}>{s.label}</SparkLink>)}
        <SparkLink tap href="/writing">Writing</SparkLink>
      </nav>
      <p>Email: <SparkLink tap href={`mailto:${site.email}`} class="text-muted">{site.email}</SparkLink></p>
    </header>

    <section id="projects" aria-labelledby="projects-h" class="flex scroll-mt-4 flex-col gap-2.5 max-md:gap-0">
      <h2 id="projects-h" class:list={[h2, 'mb-1']}>Projects</h2>
      {projects.map((p) => <ProjectRow {...p} />)}
    </section>

    {
      posts.length > 0 && (
        <section aria-labelledby="writing-h" class="flex flex-col gap-2.5 max-md:gap-0">
          <div class="mb-1 flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="writing-h" class={h2}>Writing</h2>
            <SparkLink tap href="/writing" class="text-muted">All posts →</SparkLink>
          </div>
          {posts.map((post) => (
            <a
              href={`/writing/${post.id}`}
              class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5 py-0.5 no-underline max-md:gap-y-1 max-md:border-t max-md:border-line max-md:py-3"
            >
              <span>
                <span class="font-bold underline decoration-edge underline-offset-3">{post.data.title}</span>
                <span class="text-muted max-md:mt-0.5 max-md:block max-md:text-[15px]">
                  <span class="max-md:hidden"> - </span>
                  {post.data.summary}
                </span>
              </span>
              <span class="meta whitespace-nowrap text-muted">{monthYear(post.data.date)}</span>
            </a>
          ))}
        </section>
      )
    }

    <section id="experience" aria-labelledby="experience-h" class="flex scroll-mt-4 flex-col gap-[18px]">
      <h2 id="experience-h" class={h2}>Experience</h2>
      <ExperienceList entries={experiences} />
    </section>

    <!-- Phones only: on desktop the header links already cover it. -->
    <section id="contact" aria-labelledby="contact-h" class="hidden scroll-mt-4 flex-col gap-2.5 max-md:flex">
      <h2 id="contact-h" class:list={[h2, 'mb-1']}>Contact</h2>
      <p class="mb-1 text-muted">Email is the fastest way to reach me.</p>
      {
        [{ label: 'Email', href: `mailto:${site.email}`, handle: site.email }, ...socials].map((c) => (
          <a
            href={c.href}
            class="flex min-h-11 flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-line py-2 no-underline active:text-accent"
          >
            <span class="font-semibold underline decoration-edge underline-offset-3">{c.label}</span>
            <span class="font-mono text-[13px] text-muted">
              {c.handle}
              {c.label !== 'Email' && ' ↗'}
            </span>
          </a>
        ))
      }
    </section>
  </main>
</Base>
