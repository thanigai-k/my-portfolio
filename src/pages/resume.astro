---
import Base from '../layouts/Base.astro'
import SparkLink from '../components/SparkLink.astro'
import Sparkle from '../components/Sparkle.astro'
import { site } from '../site.config'
import { resume as r } from '../resume'
import DesignMode from '../components/DesignMode.astro'

// Straight port of github.com/thanigai-k/resume (src/pages/resume.tsx): same markup, sizes and
// print rules, so Cmd+P from this page prints exactly like the original. Tailwind v3 tokens are
// spelled as arbitrary values (body-12px = 0.75rem/1.5, primary = black/80, secondary = black/60).
// Icons are the react-icons the original used (HiMail, HiPhone, FaLinkedin, HiGlobe), inlined.
const icons: Record<string, { box: string; d: string }> = {
  mail: {
    box: '0 0 20 20',
    d: 'M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884zM18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z',
  },
  phone: {
    box: '0 0 20 20',
    d: 'M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z',
  },
  linkedin: {
    box: '0 0 448 512',
    d: 'M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z',
  },
  globe: {
    box: '0 0 20 20',
    d: 'M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912-2.706C6.512 5.73 6.974 6 7.5 6A1.5 1.5 0 019 7.5V8a2 2 0 004 0 2 2 0 011.523-1.943A5.977 5.977 0 0116 10c0 .34-.028.675-.083 1H15a2 2 0 00-2 2v2.197A5.973 5.973 0 0110 16v-2a2 2 0 00-2-2 2 2 0 01-2-2 2 2 0 00-1.668-1.973z',
  },
}
const h2 =
  'text-black relative text-[1.125rem]/[1.5] font-bold mb-2 tracking-[0.2rem] uppercase pb-0.5 border-b-2 border-black'
const h3 = 'text-black text-[1rem]/[1.2] flex items-center gap-1 mb-2'
const dev = import.meta.env.DEV
---

<Base
  title="Resume"
  description={`${r.name}: ${r.title}. One-page resume, also as a PDF.`}
  section="home"
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
  />
  <div id="content" class="flex flex-col gap-6">
    <header class="flex flex-col gap-4 print:hidden">
      <SparkLink tap href="/" class="meta self-start text-[13px] text-muted no-underline">
        ← {site.name}
      </SparkLink>
      <div class="flex flex-col gap-1.5">
        <p class="text-2xl/tight font-bold">Resume</p>
        <p class="text-muted">A summary of my work. Read it here, print it, or download the PDF.</p>
      </div>
    </header>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-3 print:hidden">
      <a
        href="/resume.pdf"
        download="Thanigaivel-K-Resume.pdf"
        class="group/spk relative box-border inline-flex min-h-11 items-center gap-2.5 rounded-lg border border-rule bg-raised pr-[18px] pl-3.5 font-semibold text-ink no-underline transition-[border-color,box-shadow,background-color,scale] duration-200 hover:border-accent hover:text-white hover:ring-3 hover:ring-accent/12 focus-visible:border-accent focus-visible:text-white focus-visible:ring-3 focus-visible:ring-accent/12 active:scale-98 active:bg-surface active:text-accent motion-reduce:active:scale-100"
      >
        <Sparkle />
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="size-5 flex-none fill-none stroke-current stroke-[1.75] [stroke-linecap:round] [stroke-linejoin:round]"
        >
          <path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"></path>
          <g class="transition-transform duration-200 group-hover/spk:translate-y-0.5 group-focus-visible/spk:translate-y-0.5">
            <path d="M12 4v11"></path>
            <path d="m7.5 10.5 4.5 4.5 4.5-4.5"></path>
          </g>
        </svg>
        Download PDF
      </a>
      <span class="meta text-muted">PDF · A4 · Updated {r.updated}</span>
    </div>

    {dev && <DesignMode />}

    <div class="overflow-x-auto min-[868px]:-mx-6 print:overflow-visible">
      <main class="mx-auto my-10 max-w-[768px] border-4 border-black bg-white p-8 font-['Poppins',sans-serif] text-[0.75rem] leading-snug text-black/80 [@media_screen]:min-w-[700px] print:border-0 print:p-0 [&_a]:decoration-current [&_a]:decoration-1 [&_a]:underline-offset-auto">
        <section class="flex items-start justify-between text-[0.75rem]/[1.5]">
          <div class="basis-8/12">
            <h1>
              <div class="text-3xl leading-tight font-medium tracking-widest uppercase">
                {r.name}
              </div>
              <div class="text-[1rem]/[1.2] font-medium">{r.title}</div>
            </h1>
          </div>

          <ul class="basis-3/12 space-y-1">
            {r.contact.map((c) => (
              <li class="flex items-center justify-end gap-2">
                <a
                  href={c.href}
                  class="py-1"
                  {...(c.icon === 'globe' ? { target: '_blank', rel: 'noreferrer' } : {})}
                >
                  {c.label}
                </a>
                <svg
                  viewBox={icons[c.icon].box}
                  fill="currentColor"
                  aria-hidden="true"
                  width="20"
                  height="20"
                  class="flex-none"
                >
                  <path fill-rule="evenodd" d={icons[c.icon].d} />
                </svg>
              </li>
            ))}
          </ul>
        </section>
        <section>
          <h2 class={h2}>Profile</h2>
          <div class="space-y-2">
            <p>{r.profile}</p>
          </div>
        </section>
        <div class="mb-3"></div>
        <section class="flex justify-between">
          <article class="basis-8/12">
            <h2 class={h2}>Work Experience</h2>
            <div class="mb-2 flex items-center justify-between">
              <div>
                <div class="text-[1.125rem]/[1.5] font-medium text-black">{r.company.name}</div>
                <div class="text-black/60">{r.company.location}</div>
              </div>
              <div class="text-black/60">{r.company.span}</div>
            </div>
            <div class="space-y-3 border-s-2 border-[#e5e7eb] ps-4">
              {r.roles.map((role) => (
                <div class="space-y-1">
                  <div>
                    <h3 class={h3}>
                      <span class="font-medium">{role.title} </span>
                      <span class="ms-auto text-[0.75rem]/[1.5] font-normal text-black/60">
                        {role.dates}
                      </span>
                    </h3>
                  </div>
                  <div>
                    <ul class="list-disc space-y-1.5 ps-3">
                      {role.impacts.map((i) => (
                        <li set:html={i} />
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </article>
          <article class="basis-3/12">
            <h2 class={h2}>Education</h2>
            <div class="space-y-1">
              {r.education.map((e) => (
                <div>
                  <p class="font-medium">
                    {e.title} ({e.years})
                  </p>
                  <div class="text-black/60">
                    <p>{e.school}</p>
                    <p>{e.location}</p>
                  </div>
                </div>
              ))}
            </div>
            <div class="mb-3"></div>
            <h2 class={h2}>Projects</h2>
            <ul class="list-disc space-y-0.5 ps-3">
              {r.projects.map((p) => (
                <li>
                  <a href={p.href} target="_blank" title={p.label} rel="noreferrer">
                    {p.label}
                  </a>
                </li>
              ))}
            </ul>
            <div class="mb-3"></div>
            <h2 class={h2}>Skills</h2>
            <ul class="list-disc space-y-0.5 ps-3">
              {r.skills.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </article>
        </section>
      </main>
    </div>
  </div>
</Base>

<style is:global>
  @media print {
    html {
      background: #fff;
    }
  }
</style>
